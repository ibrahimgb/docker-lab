FROM ubuntu:20.04 as builder

# Install build dependencies (without jasper which is deprecated)
RUN apt-get update && apt-get install -y \
    openjdk-8-jdk \
    maven \
    libpng-dev \
    libdc1394-22 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy the entire application directory
COPY . /app

# Install OpenCV jar to Maven repository
RUN mvn install:install-file \
    -Dfile=/app/lib/opencv-3410.jar \
    -DgroupId=org.opencv \
    -DartifactId=opencv \
    -Dversion=3.4.10 \
    -Dpackaging=jar

# Build the application
RUN mvn clean package -DskipTests

# Final stage - lightweight runtime image
FROM ubuntu:20.04

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    openjdk-8-jre \
    libpng-dev \
    libdc1394-22 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only the built jar and necessary libraries from builder
COPY --from=builder /app/target/fatjar-0.0.1-SNAPSHOT.jar /app/
COPY --from=builder /app/lib/ /app/lib/

# Expose the port
EXPOSE 8080

# Set the entry command (use ubuntuupperthan18 libs for Ubuntu 20.04)
CMD ["java", "-Djava.library.path=lib/ubuntuupperthan18/", "-jar", "fatjar-0.0.1-SNAPSHOT.jar"]
